<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: el sistema muestra su propio splash (fondo + ícono). Fondo
         obsidiana y sin ícono, para pasar sin salto al splash animado de Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
